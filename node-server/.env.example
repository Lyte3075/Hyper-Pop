# Copy this file to .env for local Docker Compose use.
# Never commit a real .env file or publish setup keys.

NODE_ENV=production
PORT=10000

# Required for Hyper-Pop account verification and persistent project storage.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_PUBLISHABLE_OR_ANON_KEY
HP_STORAGE_URL=https://YOUR_PROJECT.supabase.co/functions/v1/hyperpop-node-storage

# Private one-time claim key. Generate a long random value.
HP_NODE_SETUP_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET

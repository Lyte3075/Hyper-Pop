{
  "name": "hyper-pop-node-hosting-kit",
  "version": "1.1.0",
  "private": true,
  "description": "Reusable Docker-first Node.js hosting kit and Hyper-Pop personal Node server",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "healthcheck": "node -e \"fetch('http://127.0.0.1:'+(process.env.PORT||10000)+'/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.1.0"
  },
  "type": "module"
}
